{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Australian Egg Consumption per Capita",
    "subtitle": "Annual egg consumption per person, 2021–22 to 2024–25",
    "fontSize": 23,
    "subtitleFontSize": 14,
    "anchor": "start"
  },

  "data": {
    "url": "../data/16.australian_egg_consumption.json",
    "format": {
      "type": "json"
    }
  },

  "width": 720,
  "height": 400,

  "encoding": {
    "x": {
      "field": "financial_year",
      "type": "ordinal",
      "sort": [
        "2021-22",
        "2022-23",
        "2023-24",
        "2024-25"
      ],
      "axis": {
        "title": "Financial Year",
        "labelFontSize": 13,
        "titleFontSize": 15,
        "labelAngle": 0,
        "labelPadding": 12
      }
    },

    "y": {
      "field": "eggs_per_person",
      "type": "quantitative",
      "scale": {
        "domain": [255, 270],
        "zero": false
      },
      "axis": {
        "title": "Eggs Consumed per Person",
        "labelFontSize": 13,
        "titleFontSize": 15,
        "tickCount": 6,
        "grid": true,
        "gridColor": "#E5EAF0"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "color": "#2F80C1"
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },

      "encoding": {
        "color": {
          "condition": {
            "test": "datum.financial_year === '2024-25'",
            "value": "#F2994A"
          },
          "value": "#2F80C1"
        },

        "tooltip": [
          {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial Year"
          },
          {
            "field": "eggs_per_person",
            "type": "quantitative",
            "title": "Eggs per Person",
            "format": ",.0f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "dy": -20,
        "fontSize": 15,
        "fontWeight": "bold"
      },

      "encoding": {
        "text": {
          "field": "eggs_per_person",
          "type": "quantitative",
          "format": ",.0f"
        },

        "color": {
          "condition": {
            "test": "datum.financial_year === '2024-25'",
            "value": "#E67E22"
          },
          "value": "#17324D"
        }
      }
    }
  ],

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "axis": {
      "domain": false,
      "tickColor": "#D5DDE5"
    }
  }
}