{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "background": "white",

  "title": {
    "text": "Australian Egg Consumption per Capita",
    "subtitle": "Difference from the four-year average of 262.5 eggs per person (2021–2025)",
    "font": "Arial",
    "fontSize": 21,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#4b5563",
    "anchor": "start",
    "offset": 12
  },

  "data": {
    "url": "data/16.australian_egg_consumption.json",
    "format": {
      "type": "json"
    }
  },

  "transform": [
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "eggs_per_person",
          "as": "average"
        }
      ]
    },
    {
      "calculate": "datum.eggs_per_person - datum.average",
      "as": "difference"
    },
    {
      "calculate": "datum.difference >= 0 ? 'Above Average' : 'Below Average'",
      "as": "category"
    },
    {
      "calculate": "(datum.difference > 0 ? '+' : '') + format(datum.difference, '.1f')",
      "as": "difference_label"
    },
    {
      "calculate": "abs(datum.difference)",
      "as": "absolute_difference"
    }
  ],

  "width": 500,
  "height": 380,

  "padding": {
    "top": 20,
    "bottom": 15,
    "left": 15,
    "right": 20
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#34495E",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "datum": 0
        }
      }
    },

    {
      "mark": {
        "type": "bar",
        "size": 55,
        "cornerRadiusEnd": 5
      },

      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2021-22",
            "2022-23",
            "2023-24",
            "2024-25"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 13,
            "labelAngle": 0,
            "labelPadding": 12
          }
        },

        "y": {
          "field": "difference",
          "type": "quantitative",
          "scale": {
            "domain": [-4.5, 4.5]
          },
          "axis": {
            "title": "Difference from Average (Eggs per Person)",
            "labelFontSize": 12,
            "titleFontSize": 14,
            "grid": true,
            "gridColor": "#E5EAF0",
            "tickCount": 9
          }
        },

        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Above Average",
              "Below Average"
            ],
            "range": [
              "#5AA9D6",
              "#F4A261"
            ]
          },
          "legend": {
            "title": "Consumption Level",
            "orient": "bottom",
            "direction": "horizontal",
            "labelFontSize": 12,
            "titleFontSize": 13
          }
        },

        "tooltip": [
          {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial Year"
          },
          {
            "field": "eggs_per_person",
            "type": "quantitative",
            "title": "Eggs Consumed per Person",
            "format": ".0f"
          },
          {
            "field": "average",
            "type": "quantitative",
            "title": "Four-Year Average",
            "format": ".1f"
          },
          {
            "field": "difference",
            "type": "quantitative",
            "title": "Difference from Average",
            "format": "+.1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "window": [
            {
              "op": "rank",
              "as": "deviation_rank"
            }
          ],
          "sort": [
            {
              "field": "absolute_difference",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.deviation_rank === 1 && datum.difference >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#34495E",
        "baseline": "bottom",
        "dy": -10
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2021-22",
            "2022-23",
            "2023-24",
            "2024-25"
          ]
        },
        "y": {
          "field": "difference",
          "type": "quantitative"
        },
        "text": {
          "field": "difference_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "rank",
              "as": "deviation_rank"
            }
          ],
          "sort": [
            {
              "field": "absolute_difference",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.deviation_rank === 1 && datum.difference < 0"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#34495E",
        "baseline": "top",
        "dy": 10
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2021-22",
            "2022-23",
            "2023-24",
            "2024-25"
          ]
        },
        "y": {
          "field": "difference",
          "type": "quantitative"
        },
        "text": {
          "field": "difference_label",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "domain": false,
      "tickColor": "#D5DDE5"
    },

    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}