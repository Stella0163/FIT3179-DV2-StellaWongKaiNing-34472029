
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "padding": 10,
  "title": {
    "text": "Australian Chicken Meat Production, 2005 to 2025",
    "subtitle": "Select a growth bar to highlight a year. Select it again to reset.",
    "font": "Georgia",
    "fontSize": 21,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#4b5563",
    "anchor": "start",
    "offset": 12
  },
  "data": {
    "url": "data/08.australia_chicken_meat_production_1999-2025.json",
    "format": {"type": "json"}
  },
  "vconcat": [
    {
      "width": 400,
      "height": 250,
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "labels": false,
            "ticks": false,
            "domain": false
          },
          "scale": {
            "paddingInner": 0.2,
            "paddingOuter": 0.02
          }
        },
        "y": {
          "field": "production_thousand_mt",
          "type": "quantitative",
          "title": "Production (thousand tonnes)",
          "scale": {"zero": false},
          "axis": {
            "titleFontSize": 13,
            "labelFontSize": 11,
            "grid": true,
            "gridColor": "#e5e7eb",
            "format": ",.0f"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "area",
            "color": "#C9D7C8",
            "opacity": 0.45
          }
        },
        {
          "mark": {
            "type": "line",
            "color": "#3F6B5B",
            "strokeWidth": 3
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "color": "#3F6B5B",
            "size": 50
          },
          "encoding": {
            "opacity": {
              "condition": {
                "param": "focus",
                "value": 1,
                "empty": true
              },
              "value": 0.22
            },
            "tooltip": [
              {
                "field": "year",
                "type": "ordinal",
                "title": "Year"
              },
              {
                "field": "production_thousand_mt",
                "type": "quantitative",
                "title": "Production (thousand tonnes)",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": {
                "param": "focus",
                "empty": false
              }
            }
          ],
          "mark": {
            "type": "point",
            "filled": true,
            "size": 200,
            "color": "#F2B431",
            "stroke": "#1F2A2E",
            "strokeWidth": 2
          }
        },
        {
          "transform": [
            {
              "filter": {
                "param": "focus",
                "empty": false
              }
            },
            {
              "calculate": "'Selected year: ' + datum.year",
              "as": "label1"
            },
            {
              "calculate": "'Production: ' + format(datum.production_thousand_mt, ',.0f') + ' thousand tonnes'",
              "as": "label2"
            },
            {
              "calculate": "datum.growth_percent == null ? 'Growth: not available' : 'Annual growth: ' + format(datum.growth_percent, '+.1f') + '%'",
              "as": "label3"
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "top",
                "fontSize": 12,
                "fontWeight": "bold",
                "color": "#111827"
              },
              "encoding": {
                "x": {"value": 12},
                "y": {"value": 12},
                "text": {"field": "label1"}
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "top",
                "fontSize": 12,
                "color": "#374151"
              },
              "encoding": {
                "x": {"value": 12},
                "y": {"value": 30},
                "text": {"field": "label2"}
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "top",
                "fontSize": 12,
                "color": "#374151"
              },
              "encoding": {
                "x": {"value": 12},
                "y": {"value": 48},
                "text": {"field": "label3"}
              }
            }
          ]
        }
      ]
    },
    {
      "width": 400,
      "height": 175,
      "transform": [
        {
          "filter": "datum.growth_percent != null"
        },
        {
          "calculate": "datum.growth_percent >= 0 ? 'Growth' : 'Decline'",
          "as": "direction"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeDash": [5, 4],
            "color": "#9ca3af",
            "strokeWidth": 1.2
          },
          "encoding": {
            "y": {"datum": 0}
          }
        },
        {
          "params": [
            {
              "name": "focus",
              "select": {
                "type": "point",
                "fields": ["year"],
                "on": "click",
                "toggle": "true",
                "clear": false
              }
            }
          ],
          "mark": {
            "type": "bar",
            "cursor": "pointer",
            "cornerRadiusTopLeft": 2,
            "cornerRadiusTopRight": 2
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "ordinal",
              "title": null,
              "axis": {
                "labelAngle": -45,
                "labelFontSize": 10
              },
              "scale": {
                "paddingInner": 0.16,
                "paddingOuter": 0.02
              }
            },
            "y": {
              "field": "growth_percent",
              "type": "quantitative",
              "title": "Annual growth (%)",
              "axis": {
                "titleFontSize": 13,
                "labelFontSize": 11,
                "grid": true,
                "gridColor": "#f1f5f9"
              }
            },
            "color": {
              "field": "direction",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": ["Growth", "Decline"],
                "range": ["#F2B431", "#B5382B"]
              },
              "legend": {
                "orient": "right",
                "direction": "vertical",
                "titleFontSize": 12,
                "labelFontSize": 11,
                "symbolType": "square",
                "symbolSize": 100,
                "padding": 5,
                "offset": 8
              }
            },
            "opacity": {
              "condition": {
                "param": "focus",
                "value": 1,
                "empty": true
              },
              "value": 0.25
            },
            "stroke": {
              "condition": {
                "param": "focus",
                "value": "#111827",
                "empty": false
              },
              "value": null
            },
            "strokeWidth": {
              "condition": {
                "param": "focus",
                "value": 2,
                "empty": false
              },
              "value": 0
            },
            "tooltip": [
              {
                "field": "year",
                "type": "ordinal",
                "title": "Year"
              },
              {
                "field": "growth_percent",
                "type": "quantitative",
                "title": "Annual growth (%)",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "transform": [
            {"filter": "datum.year == 2010"}
          ],
          "mark": {
            "type": "text"
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared"
    }
  },
  "config": {
    "view": {"stroke": null},
    "concat": {"spacing": 16},
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelFont": "Arial"
    }
  }
}
