{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Australia Egg Production by State, 2026",
    "subtitle": "Share of national egg production across six Australian states",
    "fontSize": 24,
    "subtitleFontSize": 14,
    "anchor": "start",
    "offset": 16
  },

  "data": {
    "url": "data/02.australian_egg_production.json",
    "format": {
      "type": "json",
      "property": "state_data"
    }
  },

  "transform": [
    {
      "calculate": "datum.share_of_national_production_percent",
      "as": "share"
    }
  ],

  "vconcat": [
    {
      "width": 650,
      "height": 460,

      "title": {
        "text": "Distribution of National Egg Production",
        "fontSize": 18,
        "anchor": "middle"
      },

      "params": [
        {
          "name": "stateSelect",
          "select": {
            "type": "point",
            "fields": ["state_code"],
            "on": "click",
            "toggle": "true",
            "clear": "dblclick"
          }
        }
      ],

      "mark": {
        "type": "arc",
        "innerRadius": 55,
        "stroke": "white",
        "strokeWidth": 2,
        "cornerRadius": 5,
        "cursor": "pointer"
      },

      "encoding": {
        "theta": {
          "field": "state_code",
          "type": "nominal",
          "sort": ["QLD", "NSW", "VIC", "WA", "SA", "TAS"]
        },

        "radius": {
          "field": "share",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "zero": true,
            "rangeMin": 70,
            "rangeMax": 190
          }
        },

        "color": {
          "field": "state",
          "type": "nominal",
          "title": "Australian State",
          "scale": {
            "domain": [
              "Queensland",
              "New South Wales",
              "Victoria",
              "Western Australia",
              "South Australia",
              "Tasmania"
            ],
            "range": [
              "#1F4E79",
              "#356FA5",
              "#5794C5",
              "#81B4D9",
              "#A9CFE8",
              "#D1E5F3"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 14,
            "labelFontSize": 13,
            "symbolSize": 180
          }
        },

        "opacity": {
          "condition": {
            "param": "stateSelect",
            "value": 1,
            "empty": true
          },
          "value": 0.2
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Production Share (%)",
            "format": ".0f"
          }
        ]
      }
    },

    {
      "width": 700,
      "height": 270,

      "title": {
        "text": "State Comparison",
        "fontSize": 18,
        "anchor": "middle"
      },

      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 6,
        "cornerRadiusTopRight": 6,
        "cursor": "pointer"
      },

      "encoding": {
        "x": {
          "field": "state_code",
          "type": "nominal",
          "title": "Australian State",
          "sort": ["QLD", "NSW", "VIC", "WA", "SA", "TAS"],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 13,
            "titleFontSize": 14
          }
        },

        "y": {
          "field": "share",
          "type": "quantitative",
          "title": "Share of National Egg Production (%)",
          "scale": {
            "domain": [0, 40]
          },
          "axis": {
            "labelFontSize": 13,
            "titleFontSize": 14,
            "gridColor": "#E5E7EB"
          }
        },

        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "Queensland",
              "New South Wales",
              "Victoria",
              "Western Australia",
              "South Australia",
              "Tasmania"
            ],
            "range": [
              "#1F4E79",
              "#356FA5",
              "#5794C5",
              "#81B4D9",
              "#A9CFE8",
              "#D1E5F3"
            ]
          },
          "legend": null
        },

        "opacity": {
          "condition": {
            "param": "stateSelect",
            "value": 1,
            "empty": true
          },
          "value": 0.2
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Production Share (%)",
            "format": ".0f"
          }
        ]
      }
    }
  ],

  "spacing": 36,

  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 14
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 14
    }
  }
}