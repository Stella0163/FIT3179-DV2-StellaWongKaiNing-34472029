
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "padding": 10,
  "title": {
    "text": "Australian Egg Production by State, 2026",
    "subtitle": "Share of national egg production across six states",
    "font": "Arial",
    "fontSize": 21,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#4b5563",
    "anchor": "start",
    "offset": 12
  },
  "data": {
    "url": "data/02.australian_egg_production.json",
    "format": {
      "type": "json",
      "property": "state_data"
    }
  },
  "transform": [
    {
      "calculate": "datum.share_of_national_production_percent",
      "as": "share"
    }
  ],
  "vconcat": [
    {
      "width": 570,
      "height": 340,
      "title": {
        "text": "Distribution of National Egg Production",
        "font": "Arial",
        "fontSize": 15,
        "anchor": "middle"
      },
      "params": [
        {
          "name": "stateSelect",
          "select": {
            "type": "point",
            "fields": ["state_code"],
            "on": "click",
            "toggle": "true",
            "clear": "dblclick"
          }
        }
      ],
      "mark": {
        "type": "arc",
        "innerRadius": 45,
        "stroke": "white",
        "strokeWidth": 2,
        "cornerRadius": 4,
        "cursor": "pointer"
      },
      "encoding": {
        "theta": {
          "field": "state_code",
          "type": "nominal",
          "sort": [
            "QLD",
            "NSW",
            "VIC",
            "WA",
            "SA",
            "TAS"
          ]
        },
        "radius": {
          "field": "share",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "zero": true,
            "rangeMin": 60,
            "rangeMax": 145
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "title": "State",
          "scale": {
            "domain": [
              "Queensland",
              "New South Wales",
              "Victoria",
              "Western Australia",
              "South Australia",
              "Tasmania"
            ],
            "range": [
              "#8A6518",
              "#5F3B74",
              "#A74E2C",
              "#329DA8",
              "#D46B9A",
              "#657C9E"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "symbolSize": 100,
            "padding": 5,
            "offset": 8
          }
        },
        "opacity": {
          "condition": {
            "param": "stateSelect",
            "value": 1,
            "empty": true
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Production Share (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "width": 570,
      "height": 220,
      "title": {
        "text": "State Comparison",
        "font": "Arial",
        "fontSize": 15,
        "anchor": "middle"
      },
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "state_code",
          "type": "nominal",
          "title": null,
          "sort": [
            "QLD",
            "NSW",
            "VIC",
            "WA",
            "SA",
            "TAS"
          ],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 11
          }
        },
        "y": {
          "field": "share",
          "type": "quantitative",
          "title": "National Production Share (%)",
          "scale": {
            "domain": [0, 40]
          },
          "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12,
            "gridColor": "#E5E7EB"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "Queensland",
              "New South Wales",
              "Victoria",
              "Western Australia",
              "South Australia",
              "Tasmania"
            ],
            "range": [
              "#8A6518",
              "#5F3B74",
              "#A74E2C",
              "#C0793E",
              "#A66A96",
              "#66715A"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "param": "stateSelect",
            "value": 1,
            "empty": true
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Production Share (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "spacing": 22,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
