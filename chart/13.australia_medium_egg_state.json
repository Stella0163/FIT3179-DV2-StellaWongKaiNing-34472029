
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "padding": 10,

  "title": {
    "text": "Distribution of Medium Egg Farms in Australia",
    "subtitle": "2024 | Share of Australia's 143 medium egg farms",
    "font": "Arial",
    "fontSize": 22,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 13,
    "subtitleColor": "#4b5563",
    "anchor": "start",
    "offset": 15
  },

  "width": 600,
  "height": 450,

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 620,
    "translate": [350, 225]
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/12.australia_egg_farms.json",
              "format": {
                "type": "json",
                "property": "state_data"
              }
            },
            "key": "state",
            "fields": ["medium_farms"]
          }
        },
        {
          "calculate": "datum.medium_farms == null ? null : datum.medium_farms / 143 * 100",
          "as": "share_percent"
        },
        {
          "calculate": "datum.properties.STATE_NAME",
          "as": "state_name"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.5
      },

      "encoding": {
        "color": {
          "field": "share_percent",
          "type": "quantitative",
          "scale": {
            "domain": [0, 70],
            "scheme": "blues"
          },
          "legend": {
            "title": "Medium Farms (%)",
            "orient": "right",
            "gradientLength": 300,
            "labelFontSize": 12,
            "titleFontSize": 12,
            "offset": 10
          }
        },

        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "medium_farms",
            "type": "quantitative",
            "title": "Medium Farms",
            "format": ",.0f"
          },
          {
            "field": "share_percent",
            "type": "quantitative",
            "title": "National Share (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "state": "New South Wales",
            "longitude": 147,
            "latitude": -32
          },
          {
            "state": "Victoria",
            "longitude": 145,
            "latitude": -37
          },
          {
            "state": "Queensland",
            "longitude": 145,
            "latitude": -23
          },
          {
            "state": "Western Australia",
            "longitude": 122,
            "latitude": -26
          },
          {
            "state": "South Australia",
            "longitude": 135,
            "latitude": -30
          },
          {
            "state": "Tasmania",
            "longitude": 147,
            "latitude": -42
          },
          {
            "state": "Northern Territory",
            "longitude": 133,
            "latitude": -19
          },
          {
            "state": "Australian Capital Territory",
            "longitude": 149,
            "latitude": -35.3
          }
        ]
      },

      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/12.australia_egg_farms.json",
              "format": {
                "type": "json",
                "property": "state_data"
              }
            },
            "key": "state",
            "fields": ["medium_farms"]
          }
        },
        {
          "filter": "datum.medium_farms != null"
        },
        {
          "calculate": "datum.medium_farms / 143 * 100",
          "as": "share_percent"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "peak_rank"
            }
          ],
          "sort": [
            {
              "field": "share_percent",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.peak_rank === 1"
        },
        {
          "calculate": "datum.state + ': ' + format(datum.share_percent, '.1f') + '%'",
          "as": "peak_label"
        }
      ],

      "layer": [
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 160,
            "color": "#F2B431",
            "stroke": "#1F2A2E",
            "strokeWidth": 2
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "state",
                "title": "Highest Share"
              },
              {
                "field": "medium_farms",
                "title": "Medium Farms",
                "format": ",.0f"
              },
              {
                "field": "share_percent",
                "title": "National Share (%)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 12,
            "font": "Arial",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#1F2A2E"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "peak_label",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
