{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Australian Chicken Meat Production by State",
    "subtitle": "2023–24 production volume. Rectangle area represents each region's contribution.",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "anchor": "start",
    "offset": 16
  },

  "data": {
    "url": "data/10.agrifutures_chicken_production.json",
    "format": {
      "type": "json"
    }
  },

  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "production_tonnes",
          "as": "total_production"
        }
      ]
    },

    {
      "calculate": "datum.production_tonnes / datum.total_production * 100",
      "as": "share_percent"
    },

    {
      "calculate": "datum.region === 'New South Wales' ? 'NSW' : datum.region === 'Victoria' ? 'VIC' : datum.region === 'Queensland' ? 'QLD' : 'SA + WA + TAS'",
      "as": "region_label"
    },

    {
      "calculate": "datum.region === 'New South Wales' || datum.region === 'Victoria' ? 0 : 813000 / 1450000",
      "as": "x_start"
    },

    {
      "calculate": "datum.region === 'New South Wales' || datum.region === 'Victoria' ? 813000 / 1450000 : 1",
      "as": "x_end"
    },

    {
      "calculate": "datum.region === 'New South Wales' || datum.region === 'Tasmania + SA + WA' ? 0 : datum.region === 'Victoria' ? 537000 / 813000 : 377000 / 637000",
      "as": "y_start"
    },

    {
      "calculate": "datum.region === 'New South Wales' ? 537000 / 813000 : datum.region === 'Tasmania + SA + WA' ? 377000 / 637000 : 1",
      "as": "y_end"
    },

    {
      "calculate": "(datum.x_start + datum.x_end) / 2",
      "as": "x_center"
    },

    {
      "calculate": "(datum.y_start + datum.y_end) / 2",
      "as": "y_center"
    },

    {
      "calculate": "format(datum.production_tonnes, ',.0f') + ' tonnes'",
      "as": "production_label"
    },

    {
      "calculate": "format(datum.share_percent, '.1f') + '%'",
      "as": "share_label"
    }
  ],

  "width": 760,
  "height": 470,

  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 5,
        "cornerRadius": 7,
        "cursor": "pointer"
      },

      "encoding": {
        "x": {
          "field": "x_start",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },

        "x2": {
          "field": "x_end"
        },

        "y": {
          "field": "y_start",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "reverse": true
          },
          "axis": null
        },

        "y2": {
          "field": "y_end"
        },

        "color": {
          "field": "region_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "SA + WA + TAS",
              "VIC",
              "QLD"
            ],
            "range": [
              "#A63A08",
              "#E66A0A",
              "#F28C38",
              "#F9B46A"
            ]
          },
          "legend": {
            "title": "Region",
            "orient": "right",
            "titleFontSize": 14,
            "labelFontSize": 12,
            "symbolSize": 180
          }
        },

        "tooltip": [
          {
            "field": "region",
            "type": "nominal",
            "title": "State / Region"
          },
          {
            "field": "production_tonnes",
            "type": "quantitative",
            "title": "Chicken Meat Production (tonnes)",
            "format": ",.0f"
          },
          {
            "field": "share_percent",
            "type": "quantitative",
            "title": "Share of Reported Production (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 20,
        "fontWeight": "bold",
        "color": "#FFFFFF",
        "dy": -30
      },

      "encoding": {
        "x": {
          "field": "x_center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },

        "y": {
          "field": "y_center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "reverse": true
          },
          "axis": null
        },

        "text": {
          "field": "region_label",
          "type": "nominal"
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 15,
        "color": "#FFFFFF",
        "dy": 0
      },

      "encoding": {
        "x": {
          "field": "x_center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },

        "y": {
          "field": "y_center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "reverse": true
          },
          "axis": null
        },

        "text": {
          "field": "production_label",
          "type": "nominal"
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 16,
        "fontWeight": "bold",
        "color": "#FFFFFF",
        "dy": 28
      },

      "encoding": {
        "x": {
          "field": "x_center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },

        "y": {
          "field": "y_center",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1],
            "reverse": true
          },
          "axis": null
        },

        "text": {
          "field": "share_label",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    }
  }
}