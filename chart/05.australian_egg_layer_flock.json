{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "background": "white",

  "title": {
    "text": "Distribution of Australia's National Laying Flock, 2025",
    "subtitle": "Graduated symbols represent each state's share of Australia's egg-laying hens",
    "font": "Arial",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#4b5563",
    "anchor": "start",
    "offset": 15
  },

  "width": 780,
  "height": 500,

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 650
  },

  "data": {
    "url": "../data/05.fsanz_australia_egg_layer_flock_2025.json",
    "format": {
      "type": "json",
      "property": "state_data"
    }
  },

  "transform": [
    {
      "calculate": "datum.share_of_national_layer_flock_percent",
      "as": "share_percent"
    },

    {
      "calculate": "datum.state_code === 'NSW_ACT' ? 147 : datum.state_code === 'QLD' ? 145 : datum.state_code === 'VIC' ? 144.5 : datum.state_code === 'WA' ? 121 : datum.state_code === 'SA' ? 135 : 147",
      "as": "longitude"
    },

    {
      "calculate": "datum.state_code === 'NSW_ACT' ? -32 : datum.state_code === 'QLD' ? -22 : datum.state_code === 'VIC' ? -37 : datum.state_code === 'WA' ? -26 : datum.state_code === 'SA' ? -30 : -42",
      "as": "latitude"
    },

    {
      "calculate": "datum.share_percent <= 10 ? '0–10%' : datum.share_percent <= 25 ? '>10–25%' : datum.share_percent <= 35 ? '>25–35%' : '>35%'",
      "as": "share_range"
    },

    {
      "calculate": "datum.share_percent <= 10 ? '#D8C4E5' : datum.share_percent <= 25 ? '#BE9ED3' : datum.share_percent <= 35 ? '#9B74BB' : '#79539E'",
      "as": "symbol_color"
    },

    {
      "calculate": "datum.state_code === 'NSW_ACT' ? 'NSW + ACT' : datum.state_code",
      "as": "map_label"
    },

    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "share_percent",
          "as": "highest_share"
        }
      ]
    },

    {
      "calculate": "datum.share_percent === datum.highest_share",
      "as": "is_highest"
    },

    {
      "calculate": "'Largest share: ' + datum.map_label",
      "as": "annotation_title"
    },

    {
      "calculate": "format(datum.share_percent, '.1f') + '% of national laying flock'",
      "as": "annotation_value"
    },

    {
      "calculate": "122",
      "as": "annotation_longitude"
    },

    {
      "calculate": "-38",
      "as": "annotation_latitude"
    }
  ],

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#F8F9FA",
        "stroke": "#D5DEE5",
        "strokeWidth": 1.3
      }
    },

    {
      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "#FFFFFF",
        "strokeWidth": 2.5,
        "cursor": "pointer"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "share_range",
          "type": "ordinal",

          "sort": [
            "0–10%",
            ">10–25%",
            ">25–35%",
            ">35%"
          ],

          "scale": {
            "domain": [
              "0–10%",
              ">10–25%",
              ">25–35%",
              ">35%"
            ],

            "range": [
              150,
              700,
              2000,
              4500
            ]
          },

          "legend": {
            "title": "Laying Flock Share (%)",
            "orient": "right",
            "direction": "vertical",
            "symbolType": "circle",
            "symbolFillColor": "#A180BD",
            "symbolStrokeColor": "#FFFFFF",
            "symbolStrokeWidth": 1.5,
            "titleFontSize": 13,
            "labelFontSize": 12,
            "offset": 20,
            "padding": 15
          }
        },

        "color": {
          "field": "symbol_color",
          "type": "nominal",
          "scale": null,
          "legend": null
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },

          {
            "field": "share_percent",
            "type": "quantitative",
            "title": "National Laying Flock Share (%)",
            "format": ".1f"
          },

          {
            "field": "share_range",
            "type": "nominal",
            "title": "Share Category"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "dx": 15,
        "dy": -12,
        "align": "left",
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#79539E"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "map_label",
          "type": "nominal"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.is_highest"
        }
      ],

      "mark": {
        "type": "rule",
        "color": "#79539E",
        "strokeWidth": 1.6
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "longitude2": {
          "field": "annotation_longitude"
        },

        "latitude2": {
          "field": "annotation_latitude"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.is_highest"
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "color": "#79539E",
        "size": 55
      },

      "encoding": {
        "longitude": {
          "field": "annotation_longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "annotation_latitude",
          "type": "quantitative"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.is_highest"
        }
      ],

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#79539E",
        "align": "center",
        "dx": 0,
        "dy": 27
      },

      "encoding": {
        "longitude": {
          "field": "annotation_longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "annotation_latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "annotation_title",
          "type": "nominal"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.is_highest"
        }
      ],

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 12,
        "color": "#6B7280",
        "align": "center",
        "dx": 0,
        "dy": 46
      },

      "encoding": {
        "longitude": {
          "field": "annotation_longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "annotation_latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "annotation_value",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },

    "legend": {
      "padding": 5,
      "offset": 2,
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}