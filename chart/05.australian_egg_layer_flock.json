{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Distribution of Australia's National Laying Flock, 2025",
    "subtitle": "Graduated symbols represent each state's share of Australia's egg-laying hens",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 15
  },

  "width": 780,
  "height": 500,

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 650
  },

  "data": {
    "url": "data/05.fsanz_australia_egg_layer_flock_2025.json",
    "format": {
      "type": "json",
      "property": "state_data"
    }
  },

  "transform": [
    {
      "calculate": "datum.share_of_national_layer_flock_percent",
      "as": "share_percent"
    },

    {
      "calculate": "datum.state_code === 'NSW_ACT' ? 147 : datum.state_code === 'QLD' ? 145 : datum.state_code === 'VIC' ? 144.5 : datum.state_code === 'WA' ? 121 : datum.state_code === 'SA' ? 135 : 147",
      "as": "longitude"
    },

    {
      "calculate": "datum.state_code === 'NSW_ACT' ? -32 : datum.state_code === 'QLD' ? -22 : datum.state_code === 'VIC' ? -37 : datum.state_code === 'WA' ? -26 : datum.state_code === 'SA' ? -30 : -42",
      "as": "latitude"
    },

    {
      "calculate": "datum.share_percent <= 10 ? '0–10%' : datum.share_percent <= 25 ? '>10–25%' : datum.share_percent <= 35 ? '>25–35%' : '>35%'",
      "as": "share_range"
    },

    {
      "calculate": "datum.share_percent <= 10 ? '#A9D6E5' : datum.share_percent <= 25 ? '#61A5C2' : datum.share_percent <= 35 ? '#2C7DA0' : '#014F86'",
      "as": "symbol_color"
    },

    {
      "calculate": "datum.state_code === 'NSW_ACT' ? 'NSW + ACT' : datum.state_code",
      "as": "map_label"
    }
  ],

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#F8F9FA",
        "stroke": "#D5DEE5",
        "strokeWidth": 1.3
      }
    },

    {
      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "#FFFFFF",
        "strokeWidth": 2.5,
        "cursor": "pointer"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "share_range",
          "type": "ordinal",
          "sort": [
            "0–10%",
            ">10–25%",
            ">25–35%",
            ">35%"
          ],

          "scale": {
            "domain": [
              "0–10%",
              ">10–25%",
              ">25–35%",
              ">35%"
            ],

            "range": [
              150,
              700,
              2000,
              4500
            ]
          },

          "legend": {
            "title": "Laying Flock Share (%)",
            "orient": "right",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "symbolType": "circle",
            "symbolFillColor": "#2878B5",
            "symbolStrokeColor": "#FFFFFF",
            "symbolStrokeWidth": 1.5,
            "offset": 20,
            "padding": 15
          }
        },

        "color": {
          "field": "symbol_color",
          "type": "nominal",
          "scale": null,
          "legend": null
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },

          {
            "field": "share_percent",
            "type": "quantitative",
            "title": "National Laying Flock Share (%)",
            "format": ".1f"
          },

          {
            "field": "share_range",
            "type": "nominal",
            "title": "Share Category"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "dx": 15,
        "dy": -12,
        "align": "left",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#17324D"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "map_label",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "legend": {
      "padding": 15,
      "offset": 20,
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}