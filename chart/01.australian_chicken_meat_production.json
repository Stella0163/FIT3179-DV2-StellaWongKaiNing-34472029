      }
    ]
  },
  "transform": [
    {
      "fold": [
        "chicken_meat",
        "slaughtered",
        "gross_value"
      ],
      "as": ["measure", "value"]
    },
    {
      "calculate": "indexof(['Jun-24','Sep-24','Dec-24','Mar-25','Jun-25','Sep-25','Dec-25','Mar-26','Jun-26'], datum.quarter)",
      "as": "quarter_order"
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "value",
          "as": "baseline"
        }
      ],
      "sort": [
        {
          "field": "quarter_order",
          "order": "ascending"
        }
      ],
      "groupby": ["measure"],
      "frame": [null, null]
    },
    {
      "calculate": "((datum.value - datum.baseline) / datum.baseline) * 100",
      "as": "change"
    },
    {
      "calculate": "datum.measure === 'chicken_meat' ? 'Chicken Meat Production' : datum.measure === 'slaughtered' ? 'Chickens Slaughtered' : 'Poultry Gross Value'",
      "as": "measure_label"
    },
    {
      "calculate": "min(max(datum.change, 0), 6)",
      "as": "positive_band1"
    },
    {
      "calculate": "min(max(datum.change - 6, 0), 6)",
      "as": "positive_band2"
    },
    {
      "calculate": "min(max(-datum.change, 0), 6)",
      "as": "negative_band1"
    },
    {
      "calculate": "min(max(-datum.change - 6, 0), 6)",
      "as": "negative_band2"
    }
  ],
  "facet": {
    "row": {
      "field": "measure_label",
      "type": "nominal",
      "title": "Date",
      "sort": [
        "Chicken Meat Production",
        "Chickens Slaughtered",
        "Poultry Gross Value"
      ],
      "header": {
        "labelFontSize": 16,
        "labelFontWeight": "bold",
        "labelOrient": "top",
        "labelAnchor": "start",
        "labelPadding": 8
      }
    }
  },
  "spec": {
    "width": 850,
    "height": 85,
    "encoding": {
      "x": {
        "field": "quarter",
        "type": "ordinal",
        "sort": [
          "Jun-24",
          "Sep-24",
          "Dec-24",
          "Mar-25",
          "Jun-25",
          "Sep-25",
          "Dec-25",
