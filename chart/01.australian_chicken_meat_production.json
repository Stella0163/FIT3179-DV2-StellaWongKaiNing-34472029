
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "padding": {
    "top": 10,
    "bottom": 10,
    "left": 10,
    "right": 110
  },
  "title": {
    "text": "Quarterly Performance of Australia's Chicken Industry",
    "subtitle": "Percentage change relative to June 2024",
    "font": "Georgia",
    "fontSize": 21,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#4b5563",
    "anchor": "start",
    "offset": 12
  },
  "data": {
    "url": "../data/01.chicken_quarterly_2024-2026.json",
    "format": {
      "type": "json",
      "property": "values"
    }
  },
  "transform": [
    {
      "fold": [
        "chicken_meat",
        "slaughtered",
        "gross_value"
      ],
      "as": ["measure", "value"]
    },
    {
      "calculate": "indexof(['Jun-24','Sep-24','Dec-24','Mar-25','Jun-25','Sep-25','Dec-25','Mar-26','Jun-26'], datum.quarter)",
      "as": "quarter_order"
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "value",
          "as": "baseline"
        }
      ],
      "sort": [
        {
          "field": "quarter_order",
          "order": "ascending"
        }
      ],
      "groupby": ["measure"],
      "frame": [null, null]
    },
    {
      "calculate": "((datum.value - datum.baseline) / datum.baseline) * 100",
      "as": "change"
    },
    {
      "calculate": "datum.measure === 'chicken_meat' ? 'Chicken Meat Production' : datum.measure === 'slaughtered' ? 'Chickens Slaughtered' : 'Poultry Gross Value'",
      "as": "measure_label"
    },
    {
      "calculate": "min(max(datum.change, 0), 6)",
      "as": "positive_band1"
    },
    {
      "calculate": "min(max(datum.change - 6, 0), 6)",
      "as": "positive_band2"
    },
    {
      "calculate": "min(max(-datum.change, 0), 6)",
      "as": "negative_band1"
    },
    {
      "calculate": "min(max(-datum.change - 6, 0), 6)",
      "as": "negative_band2"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "peak_rank"
        }
      ],
      "sort": [
        {
          "field": "change",
          "order": "descending"
        }
      ],
      "groupby": ["measure"]
    },
    {
      "calculate": "datum.change > 6 ? datum.positive_band2 : datum.positive_band1",
      "as": "peak_position"
    },
    {
      "calculate": "'Peak: ' + format(datum.change, '+.1f') + '%'",
      "as": "peak_label"
    }
  ],
  "facet": {
    "row": {
      "field": "measure_label",
      "type": "nominal",
      "title": null,
      "sort": [
        "Chicken Meat Production",
        "Chickens Slaughtered",
        "Poultry Gross Value"
      ],
      "header": {
        "labelFont": "Arial",
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelOrient": "top",
        "labelAnchor": "start",
        "labelPadding": 6
      }
    }
  },
  "spec": {
    "width": 500,
    "height": 90,
    "encoding": {
      "x": {
        "field": "quarter",
        "type": "ordinal",
        "title": null,
        "sort": [
          "Jun-24",
          "Sep-24",
          "Dec-24",
          "Mar-25",
          "Jun-25",
          "Sep-25",
          "Dec-25",
          "Mar-26",
          "Jun-26"
        ],
        "axis": {
          "labelAngle": 0,
          "labelFontSize": 10,
          "domainColor": "#9ca3af",
          "tickColor": "#9ca3af"
        }
      },
      "tooltip": [
        {
          "field": "quarter",
          "type": "ordinal",
          "title": "Quarter"
        },
        {
          "field": "measure_label",
          "type": "nominal",
          "title": "Indicator"
        },
        {
          "field": "value",
          "type": "quantitative",
          "title": "Actual Value",
          "format": ",.1f"
        },
        {
          "field": "change",
          "type": "quantitative",
          "title": "Change from Jun 2024 (%)",
          "format": "+.2f"
        }
      ]
    },
    "layer": [
      {
        "mark": {
          "type": "area",
          "interpolate": "linear",
          "clip": true,
          "color": "#93C5FD",
          "opacity": 1
        },
        "encoding": {
          "y": {
            "field": "positive_band1",
            "type": "quantitative",
            "scale": {
              "domain": [0, 6]
            },
            "axis": null,
            "stack": null
          },
          "y2": {
            "datum": 0
          }
        }
      },
      {
        "mark": {
          "type": "area",
          "interpolate": "linear",
          "clip": true,
          "color": "#D8B4FE",
          "opacity": 1
        },
        "encoding": {
          "y": {
            "field": "negative_band1",
            "type": "quantitative",
            "scale": {
              "domain": [0, 6]
            },
            "axis": null,
            "stack": null
          },
          "y2": {
            "datum": 0
          }
        }
      },
      {
        "mark": {
          "type": "area",
          "interpolate": "linear",
          "clip": true,
          "color": "#2563EB",
          "opacity": 1
        },
        "encoding": {
          "y": {
            "field": "positive_band2",
            "type": "quantitative",
            "scale": {
              "domain": [0, 6]
            },
            "axis": null,
            "stack": null
          },
          "y2": {
            "datum": 0
          }
        }
      },
      {
        "mark": {
          "type": "area",
          "interpolate": "linear",
          "clip": true,
          "color": "#7E22CE",
          "opacity": 1
        },
        "encoding": {
          "y": {
            "field": "negative_band2",
            "type": "quantitative",
            "scale": {
              "domain": [0, 6]
            },
            "axis": null,
            "stack": null
          },
          "y2": {
            "datum": 0
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.peak_rank === 1"
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "size": 110,
          "color": "#374151",
          "stroke": "white",
          "strokeWidth": 2
        },
        "encoding": {
          "y": {
            "field": "peak_position",
            "type": "quantitative",
            "scale": {
              "domain": [0, 6]
            },
            "axis": null
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.peak_rank === 1"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 12,
          "dy": 0,
          "font": "Arial",
          "fontSize": 11,
          "fontWeight": "bold",
          "color": "#374151"
        },
        "encoding": {
          "y": {
            "field": "peak_position",
            "type": "quantitative",
            "scale": {
              "domain": [0, 6]
            },
            "axis": null
          },
          "text": {
            "field": "peak_label",
            "type": "nominal"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.quarter === 'Jun-24'"
          },
          {
            "calculate": "'Increase 0–6%'",
            "as": "legend_1"
          },
          {
            "calculate": "'Increase 6–12%'",
            "as": "legend_2"
          },
          {
            "calculate": "'Decrease 0–6%'",
            "as": "legend_3"
          },
          {
            "calculate": "'Decrease 6–12%'",
            "as": "legend_4"
          },
          {
            "fold": [
              "legend_1",
              "legend_2",
              "legend_3",
              "legend_4"
            ],
            "as": ["legend_key", "legend_label"]
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "opacity": 0
        },
        "encoding": {
          "y": {
            "datum": 0
          },
          "color": {
            "field": "legend_label",
            "type": "nominal",
            "scale": {
              "domain": [
                "Increase 0–6%",
                "Increase 6–12%",
                "Decrease 0–6%",
                "Decrease 6–12%"
              ],
              "range": [
                "#93C5FD",
                "#2563EB",
                "#D8B4FE",
                "#7E22CE"
              ]
            },
            "legend": {
              "title": "Percentage Change",
              "orient": "bottom",
              "direction": "horizontal",
              "columns": 2,
              "labelFont": "Arial",
              "labelFontSize": 11,
              "titleFont": "Arial",
              "titleFontSize": 12,
              "symbolType": "square",
              "symbolStrokeWidth": 0,
              "symbolSize": 180
            }
          }
        }
      }
    ]
  },
  "resolve": {
    "legend": {
      "color": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 18
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "orient": "bottom",
      "labelFont": "Arial",
      "labelFontSize": 11,
      "titleFont": "Arial",
      "titleFontSize": 12,
      "padding": 10
    }
  }
}
