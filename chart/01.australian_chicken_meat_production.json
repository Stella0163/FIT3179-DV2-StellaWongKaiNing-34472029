{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Quarterly Performance of Australia's Chicken Industry",
    "subtitle": "Relative performance of production, slaughter and poultry value from Jun 2024 to Jun 2026",
    "fontSize": 24,
    "subtitleFontSize": 15,
    "anchor": "start",
    "offset": 12
  },

  "width": 700,
  "height": 200,

  "data": {
    "values": [
      {
        "quarter": "Jun-24",
        "chicken_meat": 371.6,
        "slaughtered": 186411.5,
        "gross_value": 1042.8
      },
      {
        "quarter": "Sep-24",
        "chicken_meat": 372.1,
        "slaughtered": 185751.0,
        "gross_value": 1028.6
      },
      {
        "quarter": "Dec-24",
        "chicken_meat": 378.3,
        "slaughtered": 187058.8,
        "gross_value": 1032.3
      },
      {
        "quarter": "Mar-25",
        "chicken_meat": 391.2,
        "slaughtered": 189690.8,
        "gross_value": 1041.6
      },
      {
        "quarter": "Jun-25",
        "chicken_meat": 393.2,
        "slaughtered": 189819.0,
        "gross_value": 1047.8
      },
      {
        "quarter": "Sep-25",
        "chicken_meat": 389.3,
        "slaughtered": 191025.7,
        "gross_value": 1034.3
      },
      {
        "quarter": "Dec-25",
        "chicken_meat": 391.6,
        "slaughtered": 192914.0,
        "gross_value": 1039.4
      },
      {
        "quarter": "Mar-26",
        "chicken_meat": 397.0,
        "slaughtered": 198015.9,
        "gross_value": 1028.9
      },
      {
        "quarter": "Jun-26",
        "chicken_meat": 409.1,
        "slaughtered": 200279.2,
        "gross_value": 1076.7
      }
    ]
  },

  "transform": [
    {
      "fold": [
        "chicken_meat",
        "slaughtered",
        "gross_value"
      ],
      "as": [
        "measure",
        "value"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "value",
          "as": "min_value"
        },
        {
          "op": "max",
          "field": "value",
          "as": "max_value"
        }
      ],
      "groupby": [
        "measure"
      ]
    },
    {
      "calculate": "((datum.value - datum.min_value) / (datum.max_value - datum.min_value)) * 100",
      "as": "index"
    },
    {
      "calculate": "datum.measure === 'chicken_meat' ? 'Chicken Meat Production' : datum.measure === 'slaughtered' ? 'Chickens Slaughtered' : 'Poultry Gross Value'",
      "as": "measure_label"
    }
  ],

    "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
  },

  "encoding": {
    "x": {
      "field": "quarter",
      "type": "ordinal",
      "title": "Quarter",
      "sort": [
        "Jun-24",
        "Sep-24",
        "Dec-24",
        "Mar-25",
        "Jun-25",
        "Sep-25",
        "Dec-25",
        "Mar-26",
        "Jun-26"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 14,
        "titleFontSize": 16
      }
    },

    "y": {
      "field": "measure_label",
      "type": "nominal",
      "title": null,
      "sort": [
        "Chicken Meat Production",
        "Chickens Slaughtered",
        "Poultry Gross Value"
      ],
      "axis": {
        "labelFontSize": 14,
        "labelPadding": 8
      }
    },

    "color": {
      "field": "index",
      "type": "quantitative",
      "title": "Relative Level (0–100)",
      "scale": {
        "scheme": "blues",
        "domain": [0, 100]
      },
      "legend": {
        "titleFontSize": 15,
        "labelFontSize": 13
      }
    },

    "tooltip": [
      {
        "field": "quarter",
        "type": "ordinal",
        "title": "Quarter"
      },
      {
        "field": "measure_label",
        "type": "nominal",
        "title": "Indicator"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "Actual Value",
        "format": ",.1f"
      },
      {
        "field": "index",
        "type": "quantitative",
        "title": "Relative Level (0–100)",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}