          "type": "nominal",
          "title": "Quarter"
        },
        {
          "field": "measure_label",
          "type": "nominal",
          "title": "Indicator"
        },
        {
          "field": "value",
          "type": "quantitative",
          "title": "Actual Value",
          "format": ",.1f"
        },
        {
          "field": "change",
          "type": "quantitative",
          "title": "Change from Jun 2024 (%)",
          "format": "+.2f"
        }
      ]
    },
    "layer": [
