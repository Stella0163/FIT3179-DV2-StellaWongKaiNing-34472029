
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "padding": 10,
  "title": {
    "text": "Quarterly Performance of Australia's Chicken Industry",
    "subtitle": "Percentage change relative to June 2024",
    "font": "Georgia",
    "fontSize": 21,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#4b5563",
    "anchor": "start",
    "offset": 12
  },
  "data": {
    "url": "data/01.chicken_quarterly_2024-2026.json",
    "format": {
      "type": "json",
      "property": "values"
    }
  },
  "transform": [
    {
      "fold": [
        "chicken_meat",
        "slaughtered",
        "gross_value"
      ],
      "as": ["measure", "value"]
    },
    {
      "calculate": "indexof(['Jun-24','Sep-24','Dec-24','Mar-25','Jun-25','Sep-25','Dec-25','Mar-26','Jun-26'], datum.quarter)",
      "as": "quarter_order"
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "value",
          "as": "baseline"
        }
      ],
      "sort": [
        {
          "field": "quarter_order",
          "order": "ascending"
        }
      ],
      "groupby": ["measure"],
      "frame": [null, null]
    },
    {
      "calculate": "((datum.value - datum.baseline) / datum.baseline) * 100",
      "as": "change"
    },
    {
      "calculate": "datum.measure === 'chicken_meat' ? 'Chicken Meat Production' : datum.measure === 'slaughtered' ? 'Chickens Slaughtered' : 'Poultry Gross Value'",
      "as": "measure_label"
    },
    {
      "calculate": "min(max(datum.change, 0), 6)",
      "as": "positive_band1"
    },
    {
      "calculate": "min(max(datum.change - 6, 0), 6)",
      "as": "positive_band2"
    },
    {
      "calculate": "min(max(-datum.change, 0), 6)",
      "as": "negative_band1"
    },
    {
      "calculate": "min(max(-datum.change - 6, 0), 6)",
      "as": "negative_band2"
    }
  ],
  "facet": {
    "row": {
      "field": "measure_label",
      "type": "nominal",
      "title": null,
      "sort": [
        "Chicken Meat Production",
        "Chickens Slaughtered",
        "Poultry Gross Value"
      ],
      "header": {
        "labelFont": "Arial",
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelOrient": "top",
        "labelAnchor": "start",
        "labelPadding": 6
      }
    }
  },
  "spec": {
    "width": 600,
    "height": 90,
    "encoding": {
      "x": {
        "field": "quarter",
        "type": "ordinal",
        "title": null,
        "sort": [
          "Jun-24",
          "Sep-24",
          "Dec-24",
          "Mar-25",
          "Jun-25",
          "Sep-25",
          "Dec-25",
          "Mar-26",
          "Jun-26"
        ],
        "axis": {
          "labelAngle": 0,
          "labelFontSize": 10,
          "domainColor": "#9ca3af",
          "tickColor": "#9ca3af"
        }
      },
      "tooltip": [
        {
          "field": "quarter",
          "type": "ordinal",
          "title": "Quarter"
        },
        {
          "field": "measure_label",
          "type": "nominal",
          "title": "Indicator"
        },
        {
          "field": "value",
          "type": "quantitative",
          "title": "Actual Value",
          "format": ",.1f"
        },
        {
          "field": "change",
          "type": "quantitative",
          "title": "Change from Jun 2024 (%)",
          "format": "+.2f"
        }
      ]
    },
    "layer": [
      {
        "mark": {
          "type": "area",
          "interpolate": "linear",
          "clip": true,
          "color": "#F6D58A"
        },
        "encoding": {
          "y": {
            "field": "positive_band1",
            "type": "quantitative",
            "scale": {
              "domain": [0, 6]
            },
            "axis": null,
            "stack": null
          },
          "y2": {
            "datum": 0
          }
        }
      },
      {
        "mark": {
          "type": "area",
          "interpolate": "linear",
          "clip": true,
          "color": "#F4B89C"
        },
        "encoding": {
          "y": {
            "field": "negative_band1",
            "type": "quantitative",
            "scale": {
              "domain": [0, 6]
            },
            "axis": null,
            "stack": null
          },
          "y2": {
            "datum": 0
          }
        }
      },
      {
        "mark": {
          "type": "area",
          "interpolate": "linear",
          "clip": true,
          "color": "#F2B431"
        },
        "encoding": {
          "y": {
            "field": "positive_band2",
            "type": "quantitative",
            "scale": {
              "domain": [0, 6]
            },
            "axis": null,
            "stack": null
          },
          "y2": {
            "datum": 0
          }
        }
      },
      {
        "mark": {
          "type": "area",
          "interpolate": "linear",
          "clip": true,
          "color": "#B5382B"
        },
        "encoding": {
          "y": {
            "field": "negative_band2",
            "type": "quantitative",
            "scale": {
              "domain": [0, 6]
            },
            "axis": null,
            "stack": null
          },
          "y2": {
            "datum": 0
          }
        }
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 18
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
