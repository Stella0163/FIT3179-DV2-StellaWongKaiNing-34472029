
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "padding": 10,
  "title": {
    "text": "Growth of Australia's Chicken Meat Industry",
    "subtitle": "Change from 2017 to 2018 to 2023 to 2024",
    "font": "Arial",
    "fontSize": 21,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#4b5563",
    "anchor": "start",
    "offset": 12
  },
  "data": {
    "url": "../data/09.agrifutures_chicken_meat_national_value_volume.json",
    "format": {
      "type": "json"
    }
    
  },
  "transform": [
    {
      "fold": [
        "production_million_tonnes",
        "gross_value_billion_aud"
      ],
      "as": ["metric", "value"]
    },
    {
      "calculate": "datum.metric === 'production_million_tonnes' ? 'Production Volume' : 'Gross Production Value'",
      "as": "measure"
    },
    {
      "calculate": "datum.stage",
      "as": "kind"
    },
    {
      "calculate": "datum.kind === 'Starting level' ? '2017–18' : datum.kind === 'Increase' ? 'Increase' : '2023–24'",
      "as": "step"
    },
    {
      "calculate": "datum.metric === 'production_million_tonnes' ? datum.production_bottom : datum.value_bottom",
      "as": "bottom"
    },
    {
      "calculate": "datum.metric === 'production_million_tonnes' ? datum.production_top : datum.value_top",
      "as": "top"
    },
    {
      "calculate": "(datum.kind === 'Increase' ? '+' : '') + format(datum.value, '.2f')",
      "as": "short_label"
    },
    {
      "calculate": "format(datum.value, '.2f')",
      "as": "label"
    },
    {
      "calculate": "datum.metric === 'production_million_tonnes' ? datum.production_percent : datum.value_percent",
      "as": "percent_label"
    }
  ],
  "hconcat": [
    {
      "title": {
        "text": "Production volume",
        "font": "Arial",
        "fontSize": 15,
        "anchor": "start",
        "offset": 10
      },
      "width": 400,
      "height": 300,
      "transform": [
        {
          "filter": "datum.measure === 'Production Volume'"
        }
      ],
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": ["2017–18", "Increase", "2023–24"],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 11,
            "labelPadding": 8
          }
        }
      },
      "layer": [
        {
          "params": [
            {
              "name": "stepSelect",
              "select": {
                "type": "point",
                "fields": ["step"],
                "on": "click",
                "toggle": "true",
                "clear": false
              }
            }
          ],
          "mark": {
            "type": "bar",
            "size": 55,
            "cursor": "pointer",
            "cornerRadiusTopLeft": 4,
            "cornerRadiusTopRight": 4
          },
          "encoding": {
            "y": {
              "field": "bottom",
              "type": "quantitative",
              "title": "Million tonnes",
              "scale": {
                "domain": [0, 1.9]
              },
              "axis": {
                "titleFontSize": 12,
                "labelFontSize": 11,
                "gridColor": "#e5e7eb"
              }
            },
            "y2": {
              "field": "top"
            },
            "color": {
              "field": "kind",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Starting level",
                  "Increase",
                  "Ending level"
                ],
                "range": [
                  "#9AA5A0",
                  "#F2B431",
                  "#1F2A2E"
                ]
              },
              "legend": null
            },
            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.25
            },
            "stroke": {
              "condition": {
                "param": "stepSelect",
                "value": "#111827",
                "empty": false
              },
              "value": null
            },
            "strokeWidth": {
              "condition": {
                "param": "stepSelect",
                "value": 2,
                "empty": false
              },
              "value": 0
            },
            "tooltip": [
              {
                "field": "step",
                "type": "nominal",
                "title": "Stage"
              },
              {
                "field": "label",
                "type": "nominal",
                "title": "Value"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -8,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#1F2A2E"
          },
          "encoding": {
            "y": {
              "field": "top",
              "type": "quantitative"
            },
            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.35
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.kind === 'Increase'"
            }
          ],
          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -26,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#8A5A00"
          },
          "encoding": {
            "y": {
              "field": "top",
              "type": "quantitative"
            },
            "text": {
              "field": "percent_label"
            },
            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.35
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "Gross production value",
        "font": "Arial",
        "fontSize": 15,
        "anchor": "start",
        "offset": 10
      },
      "width": 260,
      "height": 300,
      "transform": [
        {
          "filter": "datum.measure === 'Gross Production Value'"
        }
      ],
      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": ["2017–18", "Increase", "2023–24"],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 11,
            "labelPadding": 8
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "size": 55,
            "cursor": "pointer",
            "cornerRadiusTopLeft": 4,
            "cornerRadiusTopRight": 4
          },
          "encoding": {
            "y": {
              "field": "bottom",
              "type": "quantitative",
              "title": "Billion AUD",
              "scale": {
                "domain": [0, 5.2]
              },
              "axis": {
                "titleFontSize": 12,
                "labelFontSize": 11,
                "gridColor": "#e5e7eb"
              }
            },
            "y2": {
              "field": "top"
            },
            "color": {
              "field": "kind",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Starting level",
                  "Increase",
                  "Ending level"
                ],
                "range": [
                  "#9AA5A0",
                  "#F2B431",
                  "#1F2A2E"
                ]
              },
              "legend": null
            },
            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.25
            },
            "stroke": {
              "condition": {
                "param": "stepSelect",
                "value": "#111827",
                "empty": false
              },
              "value": null
            },
            "strokeWidth": {
              "condition": {
                "param": "stepSelect",
                "value": 2,
                "empty": false
              },
              "value": 0
            },
            "tooltip": [
              {
                "field": "step",
                "type": "nominal",
                "title": "Stage"
              },
              {
                "field": "label",
                "type": "nominal",
                "title": "Value"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -8,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#1F2A2E"
          },
          "encoding": {
            "y": {
              "field": "top",
              "type": "quantitative"
            },
            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.35
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.kind === 'Increase'"
            }
          ],
          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -26,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#8A5A00"
          },
          "encoding": {
            "y": {
              "field": "top",
              "type": "quantitative"
            },
            "text": {
              "field": "percent_label"
            },
            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.35
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent",
      "color": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "concat": {
      "spacing": 25
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "domainColor": "#9ca3af",
      "tickColor": "#9ca3af"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
