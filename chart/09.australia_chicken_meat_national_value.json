{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Growth of Australia's Chicken Meat Industry",
    "subtitle": "How the 2017 - 2018 level built up to the 2023 - 2024 level",
    "fontSize": 24,
    "subtitleFontSize": 15,
    "anchor": "start",
    "offset": 16
  },

  "data": {
    "values": [
      {
        "measure": "Production Volume",
        "step": "2017-2018",
        "bottom": 0,
        "top": 1.19,
        "kind": "Starting level",
        "label": "1.19 million tonnes",
        "short_label": "1.19",
        "percent_label": ""
      },
      {
        "measure": "Production Volume",
        "step": "Increase",
        "bottom": 1.19,
        "top": 1.44,
        "kind": "Increase",
        "label": "+0.25 million tonnes (+21.0%)",
        "short_label": "+0.25",
        "percent_label": "+21.0%"
      },
      {
        "measure": "Production Volume",
        "step": "2023-2024",
        "bottom": 0,
        "top": 1.44,
        "kind": "Ending level",
        "label": "1.44 million tonnes",
        "short_label": "1.44",
        "percent_label": ""
      },

      {
        "measure": "Gross Production Value",
        "step": "2017-2018",
        "bottom": 0,
        "top": 3.29,
        "kind": "Starting level",
        "label": "3.29 billion dollars",
        "short_label": "3.29",
        "percent_label": ""
      },
      {
        "measure": "Gross Production Value",
        "step": "Increase",
        "bottom": 3.29,
        "top": 4.06,
        "kind": "Increase",
        "label": "+0.77 billion dollars (+23.4%)",
        "short_label": "+0.77",
        "percent_label": "+23.4%"
      },
      {
        "measure": "Gross Production Value",
        "step": "2023-2024",
        "bottom": 0,
        "top": 4.06,
        "kind": "Ending level",
        "label": "4.06 billion dollars",
        "short_label": "4.06",
        "percent_label": ""
      }
    ]
  },

  "hconcat": [
    {
      "title": {
        "text": "Production volume",
        "fontSize": 18,
        "anchor": "start",
        "offset": 12
      },

      "width": 300,
      "height": 400,

      "transform": [
        {
          "filter": "datum.measure === 'Production Volume'"
        }
      ],

      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": ["2017-2018", "Increase", "2023-2024"],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 14,
            "labelPadding": 10
          }
        }
      },

      "layer": [
        {
          "params": [
            {
              "name": "stepSelect",
              "select": {
                "type": "point",
                "fields": ["step"],
                "on": "click",
                "toggle": "true",
                "clear": false
              }
            }
          ],

          "mark": {
            "type": "bar",
            "size": 72,
            "cursor": "pointer",
            "cornerRadiusTopLeft": 5,
            "cornerRadiusTopRight": 5
          },

          "encoding": {
            "y": {
              "field": "bottom",
              "type": "quantitative",
              "title": "Million tonnes of chicken meat",
              "scale": {
                "domain": [0, 1.9]
              },
              "axis": {
                "titleFontSize": 15,
                "labelFontSize": 13,
                "gridColor": "#e5e7eb"
              }
            },

            "y2": {
              "field": "top"
            },

            "color": {
              "field": "kind",
              "type": "nominal",
              "title": "Stage",
              "scale": {
                "domain": [
                  "Starting level",
                  "Increase",
                  "Ending level"
                ],
                "range": [
                  "#9aa5a0",
                  "#e9a72f",
                  "#1f2a2e"
                ]
              },

              "legend": {
                "orient": "right",
                "direction": "vertical",
                "titleFontSize": 15,
                "labelFontSize": 14,
                "symbolSize": 180,
                "padding": 12,
                "offset": 20
              }
            },

            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.25
            },

            "stroke": {
              "condition": {
                "param": "stepSelect",
                "value": "#111827",
                "empty": false
              },
              "value": null
            },

            "strokeWidth": {
              "condition": {
                "param": "stepSelect",
                "value": 2.5,
                "empty": false
              },
              "value": 0
            },

            "tooltip": [
              {
                "field": "step",
                "type": "nominal",
                "title": "Stage"
              },
              {
                "field": "label",
                "type": "nominal",
                "title": "Value"
              }
            ]
          }
        },

        {
          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -8,
            "fontSize": 14,
            "fontWeight": "bold",
            "color": "#1f2a2e"
          },

          "encoding": {
            "y": {
              "field": "top",
              "type": "quantitative"
            },

            "text": {
              "field": "short_label"
            },

            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.35
            }
          }
        },

        {
          "transform": [
            {
              "filter": "datum.kind === 'Increase'"
            }
          ],

          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -28,
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#8a5a00"
          },

          "encoding": {
            "y": {
              "field": "top",
              "type": "quantitative"
            },

            "text": {
              "field": "percent_label"
            },

            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.35
            }
          }
        }
      ]
    },

    {
      "title": {
        "text": "Gross production value",
        "fontSize": 18,
        "anchor": "start",
        "offset": 12
      },

      "width": 360,
      "height": 400,

      "transform": [
        {
          "filter": "datum.measure === 'Gross Production Value'"
        }
      ],

      "encoding": {
        "x": {
          "field": "step",
          "type": "ordinal",
          "sort": ["2017-2018", "Increase", "2023-2024"],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 14,
            "labelPadding": 10
          }
        }
      },

      "layer": [
        {
          "mark": {
            "type": "bar",
            "size": 72,
            "cornerRadiusTopLeft": 5,
            "cornerRadiusTopRight": 5
          },

          "encoding": {
            "y": {
              "field": "bottom",
              "type": "quantitative",
              "title": "Billion dollars",
              "scale": {
                "domain": [0, 5.2]
              },
              "axis": {
                "titleFontSize": 15,
                "labelFontSize": 13,
                "gridColor": "#e5e7eb"
              }
            },

            "y2": {
              "field": "top"
            },

            "color": {
              "field": "kind",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Starting level",
                  "Increase",
                  "Ending level"
                ],
                "range": [
                  "#9aa5a0",
                  "#e9a72f",
                  "#1f2a2e"
                ]
              },
              "legend": null
            },

            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.25
            },

            "stroke": {
              "condition": {
                "param": "stepSelect",
                "value": "#111827",
                "empty": false
              },
              "value": null
            },

            "strokeWidth": {
              "condition": {
                "param": "stepSelect",
                "value": 2.5,
                "empty": false
              },
              "value": 0
            },

            "tooltip": [
              {
                "field": "step",
                "type": "nominal",
                "title": "Stage"
              },
              {
                "field": "label",
                "type": "nominal",
                "title": "Value"
              }
            ]
          }
        },

        {
          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -8,
            "fontSize": 14,
            "fontWeight": "bold",
            "color": "#1f2a2e"
          },

          "encoding": {
            "y": {
              "field": "top",
              "type": "quantitative"
            },

            "text": {
              "field": "short_label"
            },

            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.35
            }
          }
        },

        {
          "transform": [
            {
              "filter": "datum.kind === 'Increase'"
            }
          ],

          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -28,
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#8a5a00"
          },

          "encoding": {
            "y": {
              "field": "top",
              "type": "quantitative"
            },

            "text": {
              "field": "percent_label"
            },

            "opacity": {
              "condition": {
                "param": "stepSelect",
                "value": 1,
                "empty": true
              },
              "value": 0.35
            }
          }
        }
      ]
    }
  ],

  "resolve": {
    "scale": {
      "y": "independent",
      "color": "shared"
    }
  },

  "config": {
    "view": {
      "stroke": null
    },

    "concat": {
      "spacing": 70
    },

    "axis": {
      "domainColor": "#9ca3af",
      "tickColor": "#9ca3af"
    }
  }
}